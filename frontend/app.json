{
  "expo": {
    "name": "Aether Vision",
    "slug": "aether-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aethervision",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Voice Copilot precisa do microfone para ouvir seus comandos."
      },
      "bundleIdentifier": "com.aethervision.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "package": "com.aethervision.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Voice Copilot precisa do microfone para ouvir seus comandos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
