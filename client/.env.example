# Leave empty to use same-origin `/api/ws/live` (Vite proxies to :8000).
# Or set an absolute ws URL, e.g. ws://127.0.0.1:8000/ws/live
VITE_LIVE_WS_URL=

# Local-dev: force Live HUD + tools visible even if /billing/config flakes.
# Set to false only when testing the real subscription paywall UI.
VITE_DEV_UNLOCK=true
