# Leave empty to use same-origin `/api/ws/live` (Vite proxies to AETHER_API_ORIGIN).
# Or set an absolute ws URL, e.g. ws://127.0.0.1:8001/ws/live
VITE_LIVE_WS_URL=

# Dedicated ports for this project (avoid :5173 / :8000 collisions).
AETHER_HUD_PORT=5174
AETHER_API_ORIGIN=http://127.0.0.1:8001
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Local-dev: force Live HUD + tools visible even if /billing/config flakes.
# Set to false only when testing the real subscription paywall UI.
VITE_DEV_UNLOCK=true