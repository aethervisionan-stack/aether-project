# =============================================================================
# Aether Vision — Phase 1 voice pipeline
# Copy to backend/.env  →  cp .env.example .env
# All keys are optional in PIPELINE_MODE=mock (default local Bluetooth test).
# =============================================================================

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# debug | info | warning | error
LOG_LEVEL=info
# Comma-separated. Vite client origins MUST be listed for browser multipart uploads.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Pipeline mode ----------------------------------------------------------
# mock       — no paid APIs / no heavy models (recommended first Bluetooth test)
# hybrid     — real STT if configured; TTS falls back to mock when key missing
# production — expects real STT + TTS credentials (or local Whisper)
PIPELINE_MODE=mock

# --- STT (Whisper — pluggable) ----------------------------------------------
# Provider: mock | openai | local
STT_PROVIDER=mock

# OpenAI Whisper API  (STT_PROVIDER=openai)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Local openai-whisper (STT_PROVIDER=local)
# Requires: pip install openai-whisper  +  system ffmpeg on PATH
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt

# --- Consenso Alfa (multi-agent validation before TTS) ----------------------
CONSENSO_ENABLED=true
# Minimum approving agents for quorum
CONSENSO_MIN_AGENTS=2
# Fraction of agents that must approve (0.0–1.0)
CONSENSO_AGREEMENT_THRESHOLD=0.66
# Per-agent timeout
CONSENSO_TIMEOUT_MS=2500

# --- TTS --------------------------------------------------------------------
# Provider: mock | openai | elevenlabs
TTS_PROVIDER=mock

# OpenAI TTS  (TTS_PROVIDER=openai) — reuses OPENAI_API_KEY above
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy | ash | ballad | coral | echo | fable | onyx | nova | sage | shimmer
OPENAI_TTS_VOICE=alloy

# ElevenLabs TTS  (TTS_PROVIDER=elevenlabs)
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice id from ElevenLabs dashboard (e.g. Rachel default)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# mp3_44100_128 | pcm_24000 | …
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

TTS_SAMPLE_RATE=24000

# --- Latency / network resilience -------------------------------------------
REQUEST_TIMEOUT_MS=30000
# 10 MiB default upload cap for headset captures
MAX_AUDIO_BYTES=10485760
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=200

# --- Future DePIN / Solana seam (unused in Phase 1 — keep empty) ------------
DEPLOYMENT_NETWORK=
SOLANA_RPC_URL=
AETHER_AGENT_WALLET=
