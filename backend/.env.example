# =============================================================================
# Aether Vision — Phase 1 voice pipeline
# Copy to backend/.env  →  cp .env.example .env
# =============================================================================

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# debug | info | warning | error
LOG_LEVEL=info
# Comma-separated. Vite origins are always merged in code as a safety net.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Audio mock vs real (PRIMARY SWITCH) ------------------------------------
# true  → simulated STT/TTS (no paid APIs; default for Bluetooth UI tests)
# false → OpenAI Whisper (STT) + ElevenLabs or OpenAI Audio (TTS)
# On real-API failure (quota / invalid key): JSON error log + safe spoken
# fallback — Uvicorn never crashes.
USE_MOCK_AUDIO=true

# Legacy fine-grained mode (optional; USE_MOCK_AUDIO takes precedence)
# mock | hybrid | production
PIPELINE_MODE=mock

# --- STT (Whisper) ----------------------------------------------------------
# When USE_MOCK_AUDIO=false and STT_PROVIDER=mock → defaults to openai
# Provider: mock | openai | local
STT_PROVIDER=mock

# OpenAI Whisper  — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Local openai-whisper (STT_PROVIDER=local) — pip install openai-whisper + ffmpeg
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt

# --- Consenso Alfa ----------------------------------------------------------
CONSENSO_ENABLED=true
CONSENSO_MIN_AGENTS=2
CONSENSO_AGREEMENT_THRESHOLD=0.66
CONSENSO_TIMEOUT_MS=2500

# --- TTS --------------------------------------------------------------------
# When USE_MOCK_AUDIO=false and TTS_PROVIDER=mock:
#   prefers elevenlabs if ELEVENLABS_API_KEY set, else openai
# Provider: mock | openai | elevenlabs
TTS_PROVIDER=mock

# OpenAI Audio TTS — reuses OPENAI_API_KEY
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ElevenLabs TTS — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

TTS_SAMPLE_RATE=24000

# --- Latency / network resilience -------------------------------------------
REQUEST_TIMEOUT_MS=30000
MAX_AUDIO_BYTES=10485760
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=200

# --- Web3 / Solana prep (stubs in app/services/web3/ — not used by voice) ---
DEPLOYMENT_NETWORK=solana-mainnet
# Prefer Helius when available; SOLANA_RPC_URL is the generic fallback.
HELIUS_RPC_URL=
HELIUS_API_KEY=
SOLANA_RPC_URL=
# Pyth Hermes
PYTH_HERMES_URL=https://hermes.pyth.network
# Jupiter quote API
JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6
AETHER_AGENT_WALLET=
