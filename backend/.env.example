# Google AI Studio / Gemini API key (never commit the real value)
GEMINI_API_KEY=

# Live-native bidirectional audio model (Gemini Live API)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Live WebSocket requires v1beta or v1alpha (default SDK version 404s on live.connect)
GEMINI_API_VERSION=v1beta

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated CORS origins (Vite defaults always merged)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Stripe (monthly card subscription; never commit real secrets) ---
# Flip test → live with .env ONLY (no code changes). Restart uvicorn after edits.
#
#   TEST (current Gen-1 while waiting on MEI fiscal docs):
#     STRIPE_SECRET_KEY=sk_test_...          # from Stripe Dashboard → Developers → API keys
#     STRIPE_PUBLISHABLE_KEY=pk_test_...     # optional for hosted Checkout redirect
#     STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen` or Dashboard webhook
#
#   LIVE (after MEI / production account is ready — paste real keys; do NOT invent):
#     STRIPE_SECRET_KEY=sk_live_...
#     STRIPE_PUBLISHABLE_KEY=pk_live_...
#     STRIPE_WEBHOOK_SECRET=whsec_...        # production endpoint signing secret
#     # Usually also restore official price (example):
#     # STRIPE_CURRENCY=usd
#     # STRIPE_UNIT_AMOUNT_CENTS=1999
#     # STRIPE_FORCE_UNIT_AMOUNT=false
#     # STRIPE_PRICE_ID=price_...
#     # BILLING_DEV_UNLOCK=false
#
# Hosted Checkout Session.create needs STRIPE_SECRET_KEY only (sets stripe.api_key).
# A real sk_test_/sk_live_ disables mock Checkout. Placeholders keep local mock working.
# Incomplete pk_test_ is fine until you paste a Dashboard publishable key.
STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_placeholder_not_a_real_secret
# Optional existing Price id (ignored while STRIPE_FORCE_UNIT_AMOUNT=true)
STRIPE_PRICE_ID=
# --- TEMP TEST price (R$ 0,01) — restore official later ---
# Official restore example:
#   STRIPE_CURRENCY=usd
#   STRIPE_UNIT_AMOUNT_CENTS=1999
#   STRIPE_FORCE_UNIT_AMOUNT=false
STRIPE_CURRENCY=brl
STRIPE_UNIT_AMOUNT_CENTS=1
STRIPE_FORCE_UNIT_AMOUNT=true
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://127.0.0.1:5173/?checkout=cancel

# When true AND Stripe secret is empty, client can simulate a paid unlock locally
BILLING_DEV_UNLOCK=true

# TEMP: skip subscription paywall so Live/AI works without Subscribe.
# Set false (or remove) before production / when sk_live_ is ready — Stripe code stays intact.
BYPASS_SUBSCRIPTION_CHECK=false

# --- Solana tokenomics (70% treasury / 30% burn) ---
TREASURY_WALLET_ADDRESS=AVj6q1t8xWd7Mi7roNjTc1RvaqJy79P7n3XNpCVjQgxa
VISION_BURN_ADDRESS=BurnAddressPubkeyPlaceholder111111111111111
VISION_MINT_ADDRESS=VisionMintPubkeyPlaceholder1111111111111111
SOLANA_RPC_URL=https://api.devnet.solana.com
# Leave empty for stub mode (recommended locally). Never invent a real key.
SOLANA_PAYER_SECRET_KEY=
VISION_TOKENS_PER_USD=100

# Gen-1 entitlement JSON path (relative to backend cwd)
ENTITLEMENTS_PATH=data/entitlements.json
