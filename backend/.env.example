# Aether Vision — backend environment (Gemini-only)
# Copy to backend/.env and fill GEMINI_API_KEY (never commit secrets).

HOST=127.0.0.1
PORT=8001
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# true  → local mock STT/TTS + local tool agent (pytest / offline)
# false → Gemini STT + Gemini cognitive + Gemini TTS (required for phone field demos)
# Field/mobile: set USE_MOCK_AUDIO=false, PIPELINE_MODE=production, STT/TTS=gemini.
USE_MOCK_AUDIO=false
PIPELINE_MODE=production

# Providers: mock | gemini
STT_PROVIDER=gemini
TTS_PROVIDER=gemini
DEFAULT_LANGUAGE=pt

# --- Gemini (required for real audio / cognitive) ----------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# auto | gemini
COGNITIVE_PROVIDER=auto
# Gemini 2.5 Flash/Pro return 404 for new API keys — use 3.x IDs.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODE=flash
GEMINI_STT_MODEL=gemini-3.5-flash-lite
# Native TTS may fall back to local WAV if the TTS model/API rejects speechConfig.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_INJECT_SQLITE_CONTEXT=true

CONSENSO_ENABLED=true
CONSENSO_MIN_AGENTS=2
CONSENSO_AGREEMENT_THRESHOLD=0.66
CONSENSO_TIMEOUT_MS=2500

TTS_SAMPLE_RATE=24000
TTS_AUDIO_DIR=data/tts_audio

MEMORY_ENABLED=true
CHROMA_PERSIST_DIR=data/chroma
SQLITE_PATH=aether_vision.db

REQUEST_TIMEOUT_MS=120000
MAX_AUDIO_BYTES=10485760
