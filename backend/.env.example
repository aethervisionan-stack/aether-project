# Aether Vision — backend environment (Gemini-only)
# Copy to backend/.env and fill GEMINI_API_KEY (never commit secrets).

HOST=127.0.0.1
PORT=8001
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# true  → local mock STT/TTS + local tool agent (pytest / offline)
# false → Gemini STT + Gemini cognitive + Gemini TTS
USE_MOCK_AUDIO=true
PIPELINE_MODE=mock

# Providers: mock | gemini
STT_PROVIDER=mock
TTS_PROVIDER=mock
DEFAULT_LANGUAGE=pt

# --- Gemini (required for real audio / cognitive) ----------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# auto | gemini
COGNITIVE_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODE=flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_INJECT_SQLITE_CONTEXT=true

CONSENSO_ENABLED=true
CONSENSO_MIN_AGENTS=2
CONSENSO_AGREEMENT_THRESHOLD=0.66
CONSENSO_TIMEOUT_MS=2500

TTS_SAMPLE_RATE=24000
TTS_AUDIO_DIR=data/tts_audio

MEMORY_ENABLED=true
CHROMA_PERSIST_DIR=data/chroma
SQLITE_PATH=aether_vision.db

REQUEST_TIMEOUT_MS=30000
MAX_AUDIO_BYTES=10485760
