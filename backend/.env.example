# =============================================================================
# Aether Vision — Phase 1 voice pipeline
# Copy to backend/.env  →  copy .env.example .env
# Fill OPENAI_API_KEY with your key from https://platform.openai.com/api-keys
# =============================================================================

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Audio mock vs real (PRIMARY SWITCH) ------------------------------------
# true  → simulated STT/TTS (local Bluetooth UI tests without paid APIs)
# false → OpenAI Whisper + gpt-4o-mini + OpenAI TTS (tts-1-hd / nova)
# Empty OPENAI_API_KEY with USE_MOCK_AUDIO=false → structured error + safe
# spoken fallback (never silent mock Whisper success; Uvicorn stays up).
USE_MOCK_AUDIO=false

PIPELINE_MODE=production

# --- STT (Whisper) ----------------------------------------------------------
STT_PROVIDER=openai
# Paste your key from https://platform.openai.com/api-keys (must start with sk-)
# File path (absolute on disk): backend/.env  — do not put the key only in the repo-root .env
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt

# --- Agent / cognitive engine ----------------------------------------------
OPENAI_AGENT_MODEL=gpt-4o-mini
# auto | gemini | openai  (auto → Gemini when GEMINI_API_KEY is set)
COGNITIVE_PROVIDER=auto
# Google AI Studio key — https://aistudio.google.com/apikey (never commit the value)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INJECT_SQLITE_CONTEXT=true

# --- Consenso Alfa ----------------------------------------------------------
CONSENSO_ENABLED=true
CONSENSO_MIN_AGENTS=2
CONSENSO_AGREEMENT_THRESHOLD=0.66
CONSENSO_TIMEOUT_MS=2500

# --- TTS --------------------------------------------------------------------
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_SAMPLE_RATE=24000
TTS_AUDIO_DIR=data/tts_audio

# --- Adaptive memory / client DNA (local ChromaDB) --------------------------
MEMORY_ENABLED=true
CHROMA_PERSIST_DIR=data/chroma

# --- Latency / network resilience -------------------------------------------
REQUEST_TIMEOUT_MS=30000
MAX_AUDIO_BYTES=10485760
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=200

# --- Web3 / Solana prep (stubs) ---------------------------------------------
DEPLOYMENT_NETWORK=solana-mainnet
HELIUS_RPC_URL=
HELIUS_API_KEY=
SOLANA_RPC_URL=
PYTH_HERMES_URL=https://hermes.pyth.network
JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6
AETHER_AGENT_WALLET=
