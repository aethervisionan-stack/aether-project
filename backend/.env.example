# Aether Vision — Phase 1 voice pipeline
# Copy to backend/.env for local runs.

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pipeline mode: mock | hybrid | production
# mock      — no heavy models / no paid APIs (default for local Bluetooth UI tests)
# hybrid    — real STT if configured, mock TTS fallback
# production — requires API keys / local Whisper
PIPELINE_MODE=mock

# STT (Whisper — pluggable)
# Provider: mock | openai | local
STT_PROVIDER=mock
# OpenAI Whisper API (when STT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Local Whisper (when STT_PROVIDER=local) — requires openai-whisper + ffmpeg
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt

# Consenso Alfa — multi-agent validation before TTS
CONSENSO_ENABLED=true
CONSENSO_MIN_AGENTS=2
CONSENSO_AGREEMENT_THRESHOLD=0.66
CONSENSO_TIMEOUT_MS=2500

# TTS
# Provider: mock | openai
TTS_PROVIDER=mock
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
TTS_SAMPLE_RATE=24000

# Latency / network resilience
REQUEST_TIMEOUT_MS=30000
MAX_AUDIO_BYTES=10485760
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=200

# Future DePIN / Solana seam (unused in Phase 1 — keep empty)
# DEPLOYMENT_NETWORK=
# SOLANA_RPC_URL=
# AETHER_AGENT_WALLET=
