# Landing / quiz at `/` loads without env.
# InfinitePay Checkout Integrado unlocks the arquetipos paywall (result / mentor / combo).
#
# Dedicated local port for this Project ("quiz de QI" / aether IQ test):
#   package.json: `npm run dev` → next dev --turbopack -p 3010
#   Copy into .env.local (gitignored) and keep APP_URL in sync:
#     PORT=3010
#     NEXT_PUBLIC_APP_URL=http://localhost:3010
# IQ test: http://localhost:3010/teste-qi
# Do not reuse 3000/5173/8000 — those often belong to other Projects on the same machine.

# --- InfinitePay Checkout Integrado ---
# InfiniteTag sem o $. While placeholder, create-link returns a simulated local URL.
INFINITEPAY_HANDLE=COLE_AQUI_SUA_INFINITETAG_SEM_CIFRAO
INFINITEPAY_API_KEY=COLE_AQUI_SUA_API_KEY_DA_INFINITEPAY
PORT=3010
NEXT_PUBLIC_APP_URL=http://localhost:3010

# --- IQ post-test unlock via Mercado Pago Pix (R$1,00 = 100 centavos) ---
# Charged via /api/payment/pix/* after /teste-qi finish (in-page QR).
# Server registry by sessionId — localStorage/query alone never unlocks.
IQ_UNLOCK_AMOUNT_CENTAVOS=100
# Required for REAL Pix QR (Produção / Test credentials from Mercado Pago):
#   Painel MP → Seu negócio → Credenciais → Access Token
MERCADOPAGO_ACCESS_TOKEN=COLE_AQUI_SEU_ACCESS_TOKEN_MERCADOPAGO
# Optional payer email used on Pix create (defaults to qi-unlock@aethervision.local):
# MERCADOPAGO_PAYER_EMAIL=voce@email.com
# Force local simulate (localhost only). Prod always needs real Mercado Pago confirm.
# MERCADOPAGO_SIMULATE=1
# MERCADOPAGO_SIMULATE=0
# Dev: GET /api/payment/pix/status?sessionId=iq_…&simApprove=1 only on localhost.

# --- Mentor Estratégico (IA) — POST /api/mentor ---
# At least one key required for chat replies. Without keys the UI stays up and
# returns a clear JSON error for admins (code: MISSING_API_KEY).
# Prefer Gemini; OpenAI is fallback / alternative.
GEMINI_API_KEY=
# Optional model override (IQ profile + Mentor). Default tries gemini-3.5-flash-lite, then 3.8/3.5 flash:
# GEMINI_MENTOR_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=

# --- PagBank Pix (legacy; paywall migrated to InfinitePay) ---
# Token: PagBank → Venda online → Integrações → Gerar Token (or sandbox Dev portal).
PAGBANK_TOKEN=
# Optional alias accepted by the app:
# PAGSEGURO_TOKEN=
# Production API is default. Set true for sandbox.api.pagseguro.com
PAGBANK_SANDBOX=false
# Or override base URL entirely:
# PAGBANK_API_URL=https://sandbox.api.pagseguro.com
# Force mock Pix (no PagBank call) even if a token is set:
# PAGBANK_MOCK=true
# Allow POST /api/pagbank/simulate on non-development hosts (never leave on in real prod):
# PAGBANK_ALLOW_SIMULATE=false

# Everything below is optional and only for Aether Vision presale (/aether) + APIs.

# Solana RPC — mainnet or a paid endpoint (Helius, Triton, Extrnode, Ankr)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Existing $VISION mint (Phantom/Solscan Mint Address — NOT the Squads vault)
TOKEN_MINT=

# Off-chain JSON already live on Vercel
METADATA_URI=https://aether-project-eight.vercel.app/token-metadata/aether-vision.json

# Creator / mint authority / payer (JSON array from solana-keygen — do not commit)
MINT_AUTHORITY_KEYPAIR=./secrets/mint-authority.json
# Vercel: 64-byte JSON array on ONE line, no wrapping quotes, mark Sensitive.
# MINT_AUTHORITY_SECRET=[12,34,56]

# Main Phantom wallet to audit / restore (owner pubkey, not a secret)
PHANTOM_OWNER=

# Optional: mint the deficit to PHANTOM_OWNER (never the default)
ALLOW_MINT_TO_TARGET=false
EXPECTED_UI_SUPPLY=1000000000

# presale = $0.0001 / VISION. raydium = SOL_reserve / VISION_reserve spot.
VISION_PRICING=presale
RAYDIUM_VISION_IN_POOL=200000000
RAYDIUM_SOL_IN_POOL=10
# SOL_USD=97.74

# Restoration script is dry-run unless BOTH are true
RESTORE_PHANTOM_OK=false
RESTORE_EXECUTE=false

# After SOL/PIX confirmation, $VISION is transferred from this keypair (Phantom export).
# Default: MINT_AUTHORITY_KEYPAIR file. Optional override:
# DISTRIBUTION_SECRET=[1,2,3]

# Orders — Neon/Postgres on Vercel. Without this, local .data/orders.json is used.
# Vercel: paste the pooled URI on one line, no quotes. Prefer Neon -pooler + ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# PIX (Mercado Pago / Woovi / OpenPix). Key is the merchant PIX key, not a private key.
PIX_KEY=
PIX_MERCHANT_NAME=AETHER VISION
PIX_MERCHANT_CITY=SAO PAULO
PIX_BRL_PER_USD=5.5
# Required for PIX webhooks in every environment (Bearer/x-webhook-secret or x-signature HMAC).
# Also used to authorize local mock-pay when MOCK_PAY_SECRET is unset.
PIX_WEBHOOK_SECRET=
# Dev-only. Never enable in production. Mock-pay also needs PIX_WEBHOOK_SECRET or MOCK_PAY_SECRET.
PIX_ALLOW_MOCK=false
# Optional override for POST /api/orders/[id]/mock-pay (Bearer / x-mock-pay-secret).
MOCK_PAY_SECRET=

# Required for Solana payment webhooks (Bearer or x-webhook-secret). Requests rejected if unset.
SOLANA_WEBHOOK_SECRET=

# /api/solana-rpc is disabled unless both are set. Prefer direct public RPC on the client.
SOLANA_RPC_PROXY_ENABLED=false
SOLANA_RPC_PROXY_SECRET=
# Never put paid RPC API keys in NEXT_PUBLIC_* — they ship to the browser.
# NEXT_PUBLIC_SOLANA_RPC_PROXY=true  # only if you also auth the proxy another way
