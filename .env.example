# Solana RPC — mainnet or a paid endpoint (Helius, Triton, Extrnode, Ankr)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Existing $VISION mint (Phantom/Solscan Mint Address — NOT the Squads vault)
TOKEN_MINT=

# Off-chain JSON already live on Vercel
METADATA_URI=https://aether-project-eight.vercel.app/token-metadata/aether-vision.json

# Creator / mint authority / payer (JSON array from solana-keygen — do not commit)
MINT_AUTHORITY_KEYPAIR=./secrets/mint-authority.json
# Vercel: 64-byte JSON array on ONE line, no wrapping quotes, mark Sensitive.
# MINT_AUTHORITY_SECRET=[12,34,56]

# Main Phantom wallet to audit / restore (owner pubkey, not a secret)
PHANTOM_OWNER=

# Optional: mint the deficit to PHANTOM_OWNER (never the default)
ALLOW_MINT_TO_TARGET=false
EXPECTED_UI_SUPPLY=1000000000

# presale = $0.05 / VISION. raydium = SOL_reserve / VISION_reserve spot.
VISION_PRICING=presale
RAYDIUM_VISION_IN_POOL=200000000
RAYDIUM_SOL_IN_POOL=10
# SOL_USD=97.74

# Restoration script is dry-run unless BOTH are true
RESTORE_PHANTOM_OK=false
RESTORE_EXECUTE=false

# After SOL/PIX confirmation, $VISION is transferred from this keypair (Phantom export).
# Default: MINT_AUTHORITY_KEYPAIR file. Optional override:
# DISTRIBUTION_SECRET=[1,2,3]

# Orders — Neon/Postgres on Vercel. Without this, local .data/orders.json is used.
# Vercel: paste the pooled URI on one line, no quotes. Prefer Neon -pooler + ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# PIX (Mercado Pago / Woovi / OpenPix). Key is the merchant PIX key, not a private key.
PIX_KEY=
PIX_MERCHANT_NAME=AETHER VISION
PIX_MERCHANT_CITY=SAO PAULO
PIX_BRL_PER_USD=5.5
PIX_WEBHOOK_SECRET=
PIX_ALLOW_MOCK=true

# Optional Helius/Solana payment webhook
SOLANA_WEBHOOK_SECRET=
