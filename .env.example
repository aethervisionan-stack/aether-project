# Solana RPC — mainnet or a paid endpoint (Helius, Triton, Extrnode, Ankr)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Existing $VISION mint
TOKEN_MINT=

# Off-chain JSON hosted on Arweave/IPFS/HTTPS (name, symbol, image, description)
METADATA_URI=https://arweave.net/SEU_LINK_METADATA_JSON

# Creator / mint authority / payer (use ONE of these)
# JSON array from `solana-keygen` (do not commit this file)
MINT_AUTHORITY_KEYPAIR=./secrets/mint-authority.json
# Or paste the secret key JSON array (never commit)
# MINT_AUTHORITY_SECRET=[1,2,3]

# Optional: only mint the difference if ATA UI balance < 1,000,000,000
ALLOW_MINT_TO_TARGET=false
EXPECTED_UI_SUPPLY=1000000000
